# Discord application bot token (never commit the real token).
DISCORD_BOT_TOKEN=

# Restrict the bot to exactly one server, one text channel, and these user IDs.
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
DISCORD_ALLOWED_USER_IDS=

# Existing directory the Codex thread can inspect. Writes/commands require approval.
CODEX_WORKDIR=.

# Dedicated Codex profile, separate from the normal user's CODEX_HOME.
# Log in to Codex using this profile after setup; do not copy existing auth files.
# BRIDGE_CODEX_HOME=

# Optional executable override for Codex CLI.
# CODEX_BIN=codex
CODEX_MODEL=gpt-6-luna
APPROVAL_TIMEOUT_SECONDS=120
MAX_INPUT_CHARS=10000

# Local status/session/audit files; keep outside the Codex workdir if possible.
# BRIDGE_STATE_DIR=
